# ============================================================
#  IAARE Backend — Environment Configuration Template
#  Copy this file to `.env` and fill in real values.
#  The app works WITHOUT a .env file (demo/dev mode).
# ============================================================

# --- Core ---
IAARE_SECRET_KEY=change-me-to-a-long-random-string-for-production
IAARE_DEMO_MODE=true

# --- Database ---
IAARE_DATABASE_URL=sqlite:///./iaare.db

# --- WebAuthn / Passkeys ---
IAARE_RP_ID=localhost
IAARE_RP_NAME=IAARE - Punjab & Sind Bank
IAARE_EXPECTED_ORIGIN=http://localhost:5173

# --- CORS (comma separated) ---
IAARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006

# --- Email OTP (SMTP) ---
# Gmail:   smtp.gmail.com:587  (needs App Password, not account password)
# Outlook: smtp.office365.com:587
# Zoho:    smtp.zoho.in:587
# Yahoo:   smtp.mail.yahoo.com:587
# Port 465 = implicit SSL, port 587 = STARTTLS (recommended)
IAARE_SMTP_HOST=smtp.gmail.com
IAARE_SMTP_PORT=587
IAARE_SMTP_USER=
IAARE_SMTP_PASSWORD=
IAARE_SMTP_FROM=IAARE Security <no-reply@iaare.bank>

# --- SMS OTP — Fast2SMS (India, free tier) ---
# Sign up: https://www.fast2sms.com → Dashboard → Dev API → API Key
IAARE_FAST2SMS_API_KEY=

# --- SMS OTP — Twilio (international, paid) ---
# Sign up: https://www.twilio.com/try-twilio
IAARE_TWILIO_ACCOUNT_SID=
IAARE_TWILIO_AUTH_TOKEN=
IAARE_TWILIO_FROM_NUMBER=

# --- GeoIP ---
IAARE_GEOIP_ENABLED=true
