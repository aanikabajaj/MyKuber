# ============================================================
#  IAARE Backend — Environment Configuration
#  Copy this file to `.env` and fill in real values to enable
#  production integrations. Everything works WITHOUT a .env
#  file (dev/demo mode), so the prototype runs out of the box.
# ============================================================

# --- Core ---
IAARE_SECRET_KEY=change-me-to-a-long-random-string-for-production
IAARE_DEMO_MODE=true          # true = OTPs surfaced in API/logs for the live demo

# --- Database ---
IAARE_DATABASE_URL=sqlite:///./iaare.db

# --- WebAuthn / Passkeys ---
IAARE_RP_ID=localhost
IAARE_RP_NAME=IAARE - Punjab & Sind Bank
IAARE_EXPECTED_ORIGIN=http://localhost:5173

# --- CORS (comma separated) ---
IAARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email OTP (SMTP). Leave blank to use console/dev delivery. ---
IAARE_SMTP_HOST=
IAARE_SMTP_PORT=587
IAARE_SMTP_USER=
IAARE_SMTP_PASSWORD=
IAARE_SMTP_FROM=IAARE Security <no-reply@iaare.bank>

# --- SMS OTP (Twilio). Leave blank to use console/dev delivery. ---
IAARE_TWILIO_ACCOUNT_SID=
IAARE_TWILIO_AUTH_TOKEN=
IAARE_TWILIO_FROM_NUMBER=

# --- GeoIP lookup provider (free ip-api.com by default, no key needed) ---
IAARE_GEOIP_ENABLED=true
