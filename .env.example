# ============================================================
#  docker-compose variable overrides (root-level)
#  Copy to `.env` in this same directory — docker compose loads
#  it automatically. Fill in real values before `docker compose up`.
# ============================================================

# --- AI Postgres / IAARE JWT secret (must match backend/.env) ---
AI_DB_PASSWORD=ai_password
IAARE_SECRET_KEY=iaare-dev-secret-key-change-in-production-0123456789

# --- MinIO (RAG document storage) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- LLM backend ---
# Option A (default): self-hosted vLLM — requires an NVIDIA GPU.
#   Leave the vars below unset, then explicitly start it with:
#     docker compose --profile gpu up vllm
#
# Option B: no GPU — point at any hosted OpenAI-compatible provider instead.
# Uncomment and fill in one of the examples below.
#
#   Together AI  (https://api.together.xyz/v1):
# VLLM_BASE_URL=https://api.together.xyz/v1
# VLLM_API_KEY=<your Together API key>
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo
#
#   Groq  (https://api.groq.com/openai/v1):
# VLLM_BASE_URL=https://api.groq.com/openai/v1
# VLLM_API_KEY=<your Groq API key>
# VLLM_MODEL=llama-3.3-70b-versatile
#
#   OpenAI  (https://api.openai.com/v1):
# VLLM_BASE_URL=https://api.openai.com/v1
# VLLM_API_KEY=<your OpenAI API key>
# VLLM_MODEL=gpt-4o-mini
