# ============================================================
#  Wealth Intelligence AI Platform — Environment Configuration
#  Copy this file to `ai/.env` and fill in real values before
#  starting the AI Gateway.  Never commit the filled .env file.
# ============================================================

# --- AI PostgreSQL (async connection, separate from IAARE DB) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
AI_DATABASE_URL=

# --- Redis (session cache, rate limiting, Celery broker) ---
# Format: redis://<host>:<port>/<db>  or  redis://:<password>@<host>:<port>/<db>
REDIS_URL=

# --- Qdrant vector store ---
# Format: http://<host>:<port>
QDRANT_URL=

# --- vLLM inference server (OpenAI-compatible API) ---
# Works with self-hosted vLLM (needs a GPU) OR any hosted OpenAI-compatible
# provider — Together AI, Groq, Fireworks, OpenAI, etc. For a hosted
# provider, set VLLM_BASE_URL to its API base, VLLM_API_KEY to your key,
# and VLLM_MODEL to the model name it serves.
# Format: http://<host>:<port>/v1  or  https://api.<provider>.com/v1
VLLM_BASE_URL=
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3-8B

# --- IAARE backend JWT secret key (REQUIRED — no default) ---
# Must match the value of IAARE_SECRET_KEY used by the backend service.
# Used only to VALIDATE incoming JWTs; the AI module never issues tokens.
IAARE_SECRET_KEY=

# --- IAARE backend database URL (sync, read-only session) ---
# Format: sqlite:///./iaare.db  or  postgresql+psycopg2://<user>:<pw>@<host>/<db>
IAARE_DATABASE_URL=

# --- MinIO object storage (RAG document ingestion) ---
# Endpoint without protocol prefix (e.g. localhost:9000 or minio:9000)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Set to "true" only when connecting over plain HTTP in local dev
MINIO_SECURE=false
# Bucket name where regulatory/knowledge documents are uploaded
MINIO_BUCKET=

# --- Celery (async RAG ingestion worker) ---
# Usually the same Redis URL as above; can also be an AMQP broker
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Logging & observability ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Deployment environment label surfaced in structured log events
ENVIRONMENT=development

# --- Knowledge-base ingestion (local corpus) ---
# Sync PostgreSQL URL used by the Celery worker (psycopg2 driver).
# Derived automatically from AI_DATABASE_URL by replacing the async driver;
# only set this explicitly if you use a separate sync DB endpoint.
# Format: postgresql+psycopg2://<user>:<pw>@<host>:<port>/<dbname>
AI_DATABASE_SYNC_URL=
